OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1
LLM_MODEL=gpt-4o-mini
FFMPEG_PATH=ffmpeg

# Optional ASR provider examples used by the frontend settings:
# local-whisper: no API key required, model examples: small, medium, large-v1
# openai: https://api.openai.com/v1, model: whisper-1
# groq: https://api.groq.com/openai/v1, model: whisper-large-v3-turbo
# fireworks: https://api.fireworks.ai/inference/v1, model: whisper-v3
# dashscope-paraformer/dashscope-qwen-audio/xunfei/volcengine/tencent/baidu are UI placeholders until dedicated APIs are implemented.

# You can also place an extracted ffmpeg package in the project, for example:
# ../ffmpeg-8.1.2-full_build/bin/ffmpeg.exe
# ../tools/ffmpeg-8.1.2-full_build/bin/ffmpeg.exe
# tools/ffmpeg-8.1.2-full_build/bin/ffmpeg.exe
